title: 1932
subtitle: 新的一年
on-arrival: {!
// increase NSDAP vote share 
// TODO: if a public works program has started, unemployment is not so bad.
if (Q.works_program && Q.works_program >= 2) {
    Q.unemployed -= 1;
    Q.inflation += 1
}
Q.sa_strength += 100;
Q.sh_strength += 100;
Q.sa_militancy += 0.05;
Q.old_middle_nsdap += 6;
Q.rural_nsdap += 4;
Q.unemployed_nsdap += 4;
if (Q.old_demographics) {
    Q.catholics_z += 5;
}
if (!Q.works_program) {
    Q.unemployed += 6; 
    Q.inflation -= 2;
    Q.catholics_z += 4;
    Q.workers -= 5;
    Q.rural_dnvp -= 6;
    Q.rural_nsdap += 8; 
    Q.new_middle_nsdap += 10; 
    Q.old_middle_nsdap += 10;
    Q.unemployed_nsdap += 6;
    Q.workers_nsdap += 5;
    Q.workers_kpd += 5;
    Q.sa_strength += 200;
} else if (Q.unemployed > 25) {
    Q.rural_nsdap += 5;
    Q.unemployed_nsdap += 5;
    Q.old_middle_nsdap += 5;
    Q.new_middle_nsdap += 4;
    Q.sa_strength += 50;
} else if (Q.unemployed > 20) {
    Q.rural_nsdap += 2;
    Q.unemployed_nsdap += 2;
    Q.old_middle_nsdap += 2;
    Q.new_middle_nsdap += 2;
}
!}
tags: event
view-if: year = 1932 and month = 1 
priority: 2
max-visits: 1

新的一年开始了。[? if works_program = 0 : 对于德国来说基本没有什么好消息。经济萧条仍未见底。 ?][? if works_program >= 1 and unemployment >= 20 : 我们已经开始实行了公共工程计划，但失业率仍然居高不下。不过人们终于开始乐观了起来。 ?][? if works_program >= 1 and unemployment < 20 : 我们开始实行了公共工程计划，失业率终于开始降低了。人们终于开始乐观起来。 ?]

总统选举于今年四月举行。
